# ─── Rossmann ───────────────────────────────────────────────────────────────
# Bazowy adres serwisu (zwykle nie trzeba zmieniać).
ROSSMANN_BASE_URL=https://www.rossmann.pl

# Adres strony marki Heiki Heiki na rossmann.pl, z której wykrywane są produkty.
# Podstaw faktyczny URL listingu marki (skopiuj z przeglądarki po wejściu na markę).
ROSSMANN_BRAND_URL=https://www.rossmann.pl/szukaj?Search=heiki%20heiki

# ─── Przeglądarka / antybot ──────────────────────────────────────────────────
# true = bez okna (na serwerze), false = z oknem (przydatne przy pierwszym
# uruchomieniu i debugowaniu ochrony Akamai).
HEADLESS=true

# Ile równoległych zapytań o dostępność (ostrożnie — za dużo = blokada).
CONCURRENCY=4

# Opóźnienie (ms) między zapytaniami w obrębie jednego workera (rate limiting).
REQUEST_DELAY_MS=350

# Ścieżka do trwałego profilu przeglądarki (cookies/ciastka Akamai między uruchomieniami).
USER_DATA_DIR=./data/browser-profile

# ─── Google Sheets ───────────────────────────────────────────────────────────
# ID arkusza (z URL: https://docs.google.com/spreadsheets/d/<TO_ID>/edit)
GOOGLE_SHEET_ID=
# Ścieżka do pliku JSON konta serwisowego Google (patrz README).
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
# Nazwa zakładki, do której trafiają wyniki (zostanie utworzona jeśli nie istnieje).
GOOGLE_SHEET_TAB=Dostępność
